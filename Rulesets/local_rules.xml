<group name="local,syslog,sshd,">

  <rule id="100003" level="3">
    <if_sid>60103</if_sid>
    <field name="win.eventdata.accessMask">0x2</field>
    <description>File created on Windows system.</description>
  </rule>

  <rule id="100004" level="12" frequency="50" timeframe="2">
    <if_matched_sid>100003</if_matched_sid>
    <description>FATAL ALERT: Mass File Creation Detected - Potential Ransomware!</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

</group>
